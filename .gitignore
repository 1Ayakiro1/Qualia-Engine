# Generated artifacts for the sole current build; metadata may stay tracked.
/builds/**/*.AppImage
/builds/**/*.tar.gz
/builds/**/*.zip
/builds/**/binary/
/builds/**/binary-previous-*/
/builds/**/SHA256SUMS
/.build-staging-*/
/.build-publish-*/
/tools/__pycache__/
/scripts/__pycache__/

# Native and Flutter build trees are generated locally/CI and must not pollute
# source diffs. Keep reproducible release artifacts only in builds/<VERSION>/.
/core/build/
/core/ci-*/
/build/
/app/build/
/app/.dart_tool/
/modules/**/__pycache__/
/modules/**/dist/
