{
  "format": "qualia-module", "schemaVersion": 1,
  "id": "python-gain", "name": "Python Gain", "version": "0.1.0",
  "runtime": "process-v1", "platform": "linux-x64",
  "languages": ["Python"],
  "launch": {
    "executable": "runtime/ld-linux-x86-64.so.2",
    "arguments": ["--library-path", "runtime/lib", "runtime/bin/python3", "-I", "-S", "src/main.py"]
  },
  "ports": {"inputs": ["input"], "outputs": ["output"]},
  "portSchemas": {"inputs": {"input": {"type": "number"}}, "outputs": {"output": {"type": "number"}}},
  "ui": [
    {"id": "gain", "type": "number", "label": "Gain", "default": 2},
    {"id": "sample", "type": "number", "label": "Sample", "default": 3},
    {"id": "run", "type": "button", "label": "Run"},
    {"id": "result", "type": "label", "label": "Result"},
    {"id": "parameterKeys", "type": "label", "label": "Received parameters"}
  ]
}
